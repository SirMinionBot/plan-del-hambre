# Proyecto Supabase (Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Opcional: importador de recetas. Sin clave, la UI de importación no aparece.
VITE_SPOONACULAR_KEY=

# Opcional: Web Push. Genera el par con `npx web-push generate-vapid-keys`.
# La privada va como secret de la Edge Function, NUNCA aquí.
VITE_VAPID_PUBLIC_KEY=
